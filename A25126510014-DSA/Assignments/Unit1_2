#include <stdio.h>
int main()
{
    int n, i, j, key;
    int count = 0;

    printf("Enter number of students: ");
    scanf("%d", &n);
    int a[n];
    printf("Enter marks:\n");
    for(i = 0; i < n; i++)
        scanf("%d", &a[i]);
    printf("\nArray after each pass:\n");
    for(i = 1; i < n; i++)
    {
        key = a[i];
        j = i - 1;
        while(j >= 0 && a[j] > key)
        {
            a[j + 1] = a[j];
            j--;
            count++;
        }
        a[j + 1] = key;
        printf("Pass %d: ", i);
        for(j = 0; j < n; j++)
            printf("%d ", a[j]);
        printf("\n");
    }
    printf("\nFinal sorted list: ");
    for(i = 0; i < n; i++)
        printf("%d ", a[i]);
    printf("\nTotal number of shifts = %d\n", count);
    return 0;
}
